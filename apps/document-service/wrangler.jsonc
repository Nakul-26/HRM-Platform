{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrm-document-service",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "JWT_KID": "default",
    "S3_BUCKET": "hrm-documents"
  }
  // Secrets (JWT_SIGNING_KEY, S3_ENDPOINT, S3_ACCESS_KEY_ID,
  // S3_SECRET_ACCESS_KEY) are set via `wrangler secret put`, never committed
  // here — see docs/architecture/06-security.md. Production points this at
  // R2 (S3-compatible); local dev/CI point at the docker-compose MinIO
  // instance, same code path either way.
}
