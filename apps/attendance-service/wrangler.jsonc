{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrm-attendance-service",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8791 },
  "vars": {
    "JWT_KID": "default"
  }
  // Secrets (JWT_SIGNING_KEY, APP_DATABASE_URL) are set via `wrangler secret
  // put`, never committed here — see docs/architecture/06-security.md.
  // Production wiring goes through a Hyperdrive binding rather than a raw
  // connection string once one exists to point at:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-id>" }]
}
