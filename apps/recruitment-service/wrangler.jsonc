{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrm-recruitment-service",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8793 },
  "vars": {
    "JWT_KID": "default",
    "S3_BUCKET": "hrm-documents"
  }
  // Secrets (JWT_SIGNING_KEY, APP_DATABASE_URL, S3_ENDPOINT, S3_ACCESS_KEY_ID,
  // S3_SECRET_ACCESS_KEY) are set via `wrangler secret put`, never committed
  // here — see docs/architecture/06-security.md. Resumes share
  // apps/document-service's bucket under a `resumes/` key prefix rather than
  // a dedicated bucket — same MinIO instance locally, same R2 bucket in prod.
}
