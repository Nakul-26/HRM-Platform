{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // Turbo 2's default strict env mode only forwards env vars listed here to
  // task subprocesses (everything else is stripped, not just excluded from
  // the cache hash) — without this, `turbo run test:integration` silently
  // drops DATABASE_URL/APP_DATABASE_URL/etc. even though CI and local dev
  // both set them, and every test fails on "environment configuration
  // invalid" with no obvious link back to turbo. These are the full set of
  // runtime vars any task in this repo reads (see .env.example).
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "APP_DATABASE_URL",
    "REDIS_URL",
    "JWT_SIGNING_KEY",
    "JWT_KID",
    "ROOT_DOMAIN",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
