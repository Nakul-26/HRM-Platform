# Copy to .env and fill in for local dev. Never commit the real .env
# (docs/architecture/07-infrastructure-devops.md, "Secrets & config").

NODE_ENV=development

# Admin/migration connection — superuser, used only by drizzle-kit and migrate.ts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrm

# Runtime connection for services — the hrm_app role created by
# packages/db/src/rls/enable-rls.sql, deliberately not the table owner so
# RLS policies actually apply. Never point request-serving code at DATABASE_URL.
APP_DATABASE_URL=postgresql://hrm_app:hrm_app_dev_password@localhost:5432/hrm

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=replace-with-a-real-32-plus-character-secret
JWT_KID=default

ROOT_DOMAIN=hrm.localhost

# MinIO (R2 stand-in for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=hrm-documents
